{
  "name": "orbit",
  "private": true,
  "version": "0.6.0",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @orbit/web dev",
    "build": "pnpm --filter @orbit/api-client build && pnpm --filter @orbit/contracts build && pnpm --filter @orbit/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "api:generate": "node scripts/generate-api-client.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}